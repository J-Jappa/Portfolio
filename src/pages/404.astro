---
import Layout from "../layouts/Layout.astro";
---

<!-- src/pages/404.astro -->
<Layout title="Not found">
  <div class="flex min-h-[50vh] flex-col items-start justify-center">
    {/* [check] drafted for Jasper */}
    <h1
      class="text-3xl font-semibold tracking-tight sm:text-4xl"
      style="font-family: var(--font-site);"
    >
      Nothing at this address. Either I moved it or I never built it.
    </h1>

    <!-- Home link -->
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg border border-accent/40 bg-accent/5 px-5 py-2.5 text-sm font-medium text-accent no-underline transition-colors hover:border-accent/70 hover:bg-accent/10 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-dashed"
      style="font-family: var(--font-site);"
    >
      Back to projects
    </a>
  </div>
</Layout>
