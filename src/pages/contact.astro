---
import Layout from "../layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title="Contact" description="Get in touch with Jasper Japp">
  <!-- Page heading -->
  <div class="mb-10">
    <h1
      class="text-3xl font-semibold tracking-tight sm:text-4xl"
      style="font-family: var(--font-site);"
    >
      Get in touch
    </h1>
    <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-foreground/85">
      The best way to reach me is email: <a
        id="email-link"
        href="#"
        class="underline decoration-dashed underline-offset-4 hover:text-accent"
        >loading</a
      >. Otherwise there's always <a
        href={SITE.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-dashed underline-offset-4 hover:text-accent"
        >LinkedIn</a
      >.
    </p>
  </div>
</Layout>

<script>
  // Email is stored as char codes so it never appears as plain text in the HTML.
  const codes = [
    106, 97, 115, 112, 101, 114, 106, 97, 112, 112, 64, 103, 109, 97, 105, 108,
    46, 99, 111, 109,
  ];
  const email = codes.map(c => String.fromCharCode(c)).join("");

  function wireEmail() {
    const link = document.getElementById(
      "email-link"
    ) as HTMLAnchorElement | null;
    if (link) {
      link.href = "mailto:" + email;
      link.textContent = email;
    }
  }
  wireEmail();
  document.addEventListener("astro:after-swap", wireEmail);
</script>
