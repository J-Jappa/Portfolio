---
import Layout from "../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { thumbSrc } from "@/utils/thumbs";
import CarWireframe from "@/components/CarWireframe.astro";

const projects = (await getCollection(
  "projects",
  ({ data }) => !data.draft
)) as CollectionEntry<"projects">[];

// Featured first, then by `order` (asc), then by date (newest first)
const sorted = [...projects].sort((a, b) => {
  const fa = a.data.featured ? 1 : 0;
  const fb = b.data.featured ? 1 : 0;
  if (fb - fa) return fb - fa;

  const oa = a.data.order ?? 0;
  const ob = b.data.order ?? 0;
  if (oa !== ob) return oa - ob;

  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  return db - da;
});

const featured = sorted.slice(0, 3);
const rest = sorted.slice(3);

// Every project image, for the shuffled strip near the bottom
const strip = sorted.flatMap(p =>
  (p.data.images ?? []).map((img: { src: string; alt?: string }) => ({
    src: thumbSrc(img.src),
    alt: img.alt ?? p.data.title,
    slug: p.slug,
    title: p.data.title,
  }))
);
---

<Layout
  title="Jasper Japp"
  description="Engineering portfolio of Jasper Japp: solar car aerodynamics, Currawong (a haptic-dial music player), carbon structures and bushfire detection."
>
  <!-- Hero -->
  <section
    id="hero"
    class="relative mb-16 flex flex-col gap-10 py-6 lg:mb-20 lg:flex-row lg:items-center lg:gap-12 lg:py-10"
    aria-label="Introduction"
  >
    <!-- Blueprint-grid accent (desktop pointer; static touch/reduced-motion) -->
    <div
      id="hero-grid"
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl opacity-0 transition-opacity duration-500"
    >
      <canvas id="hero-canvas" class="h-full w-full"></canvas>
    </div>

    <!-- Text column -->
    <div class="relative z-10 flex flex-col gap-5 lg:flex-1">
      <!-- Alternatives Jasper has seen and passed on for now:
           "Two solar cars, one carbon chassis and a sensor that can smell smoke."
           "I like the problems where the physics fights back." -->
      <h1
        class="text-3xl leading-tight font-semibold tracking-tight text-foreground sm:text-4xl"
        style="font-family: var(--font-site);"
      >
        Aerodynamics, carbon fibre and machine learning
      </h1>

      {/* [check] Jasper's draft, lightly edited */}
      <p class="max-w-2xl text-lg leading-relaxed text-foreground/80">
        Hey! I'm Jasper, thanks for stopping by. I'm an engineer based in
        Sydney and I like working on a pretty wide range of things. If I keep
        this updated, you'll see a bit of that here.
      </p>
      <p class="max-w-2xl text-lg leading-relaxed text-foreground/80">
        I spent the last few years studying and building solar powered cars to
        race from Darwin to Adelaide. I worked on two of them, starting with
        aerodynamics and then branching out into everything from composites to
        mechanical design. The second car, SC4 (or Monty), should be on the
        right or just below this. Feel free to give it a spin.
      </p>
      <p class="max-w-2xl text-lg leading-relaxed text-foreground/80">
        There's plenty more to look around, so click through a project, whether
        it's <a
          href="/projects/bushfire-detection/"
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          >machine learning for bushfire detection</a
        > or a <a
          href="/projects/currawong/"
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          >responsive MP3 player</a
        >, or have a look at my <a
          href="/photoscope/"
          data-astro-reload
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          >photography</a
        >. Hopefully something here takes your fancy. These days I'm an
        Engineering Specialist at AirTrunk here in Sydney.
        <a
          href="/about"
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          >More about me</a
        > or <a
          href="/contact"
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          >say hello</a
        >.
      </p>
    </div>

    <!-- Wireframe solar car: three.js x-ray of the CFD surface mesh
         (decorative; the 3D chunk lazy-loads when visible) -->
    <div class="relative z-10 lg:w-96 xl:w-[28rem]">
      <CarWireframe
        class="h-56 sm:h-64 xl:h-72"
        caption="Monty, SC4. Drag to turn it."
        captionBelow
        intro
      />
    </div>
  </section>

  <!-- Hairline rule -->
  <hr class="mb-12 border-border" />

  <!-- Selected work -->
  <section class="mb-16" aria-labelledby="selected-heading">
    <h2
      id="selected-heading"
      class="mb-8 text-xl font-semibold"
      style="font-family: var(--font-site);"
    >
      Selected work
    </h2>

    <div class="flex flex-col gap-6" id="featured-list">
      {
        featured.map(p => (
          <article>
            <a
              href={`/projects/${p.slug}/`}
              class="group block card-hover rounded-2xl p-5 no-underline outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-dashed"
              data-analytics="project"
              data-project={p.slug}
              data-title={p.data.title}
            >
              <h3
                class="text-lg font-semibold tracking-tight"
                style="font-family: var(--font-site);"
              >
                <span class="u-ink">{p.data.title}</span>
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-foreground/75">
                {p.data.summary}
              </p>

              {(p.data.images ?? []).length > 0 && (
                <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
                  {(p.data.images ?? [])
                    .slice(0, 3)
                    .map((img: { src: string; alt?: string }) => (
                      <div class="aspect-video overflow-hidden rounded-lg">
                        <img
                          src={thumbSrc(img.src)}
                          alt={img.alt ?? p.data.title}
                          class="h-full w-full object-cover transition group-hover:brightness-105 group-hover:saturate-110"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ))}
                </div>
              )}

              {p.data.stat ? (
                <p class="mt-3 font-serif text-sm tracking-wide text-accent-2">
                  ↳ {p.data.stat}
                </p>
              ) : null}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Hairline rule -->
  <hr class="mb-12 border-border" />

  <!-- All projects -->
  {
    rest.length > 0 && (
      <section class="mb-16" aria-labelledby="all-projects-heading">
        <h2
          id="all-projects-heading"
          class="mb-8 text-xl font-semibold"
          style="font-family: var(--font-site);"
        >
          All projects
        </h2>

        <div
          class="grid grid-cols-1 gap-4 lg:grid-cols-2"
          id="all-projects-list"
        >
          {rest.map(p => (
            <article>
              <a
                href={`/projects/${p.slug}/`}
                class="group block h-full card-hover rounded-xl p-4 no-underline outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-dashed"
                data-analytics="project"
                data-project={p.slug}
                data-title={p.data.title}
              >
                {/* Three thumbnails read as a story: concept, build, finished */}
                {(p.data.images ?? []).length > 0 && (
                  <div class="mb-3 grid grid-cols-3 gap-1.5">
                    {(p.data.images ?? [])
                      .slice(0, 3)
                      .map((img: { src: string; alt?: string }) => (
                        <div class="aspect-video overflow-hidden rounded-lg">
                          <img
                            src={thumbSrc(img.src)}
                            alt={img.alt ?? p.data.title}
                            class="h-full w-full object-cover transition group-hover:brightness-105 group-hover:saturate-110"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      ))}
                  </div>
                )}

                <h3
                  class="text-base font-semibold tracking-tight"
                  style="font-family: var(--font-site);"
                >
                  <span class="u-ink">{p.data.title}</span>
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-foreground/70">
                  {p.data.summary}
                </p>

                {p.data.stat ? (
                  <p class="mt-2 font-serif text-sm tracking-wide text-accent-2">
                    ↳ {p.data.stat}
                  </p>
                ) : null}
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- Hairline rule -->
  <hr class="mb-12 border-border" />

  <!-- Build photos: every project photo, shuffled on each visit and
       drifting sideways on its own (paused on hover, touch or focus) -->
  <section class="mb-16" aria-labelledby="strip-heading">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2
        id="strip-heading"
        class="text-xl font-semibold"
        style="font-family: var(--font-site);"
      >
        Build photos
      </h2>
      <div class="hidden shrink-0 gap-1 sm:flex" aria-hidden="true">
        <button
          type="button"
          class="strip-btn"
          data-strip-dir="-1"
          title="Scroll back"
        >
          ←
        </button>
        <button
          type="button"
          class="strip-btn"
          data-strip-dir="1"
          title="Scroll forward"
        >
          →
        </button>
      </div>
    </div>
    <ul
      id="workshop-strip"
      class="-mx-4 flex gap-3 overflow-x-auto px-4 pb-3"
      style="scrollbar-width: thin;"
    >
      {
        strip.map(s => (
          <li class="w-64 shrink-0 sm:w-72">
            <a
              href={`/projects/${s.slug}/`}
              class="group block no-underline"
              title={s.title}
            >
              <div class="aspect-video overflow-hidden rounded-lg border border-border transition-colors group-hover:border-accent/60">
                <img
                  src={s.src}
                  alt={s.alt}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Elsewhere -->
  <section class="mb-4" aria-labelledby="elsewhere-heading">
    <h2
      id="elsewhere-heading"
      class="mb-8 text-xl font-semibold"
      style="font-family: var(--font-site);"
    >
      Elsewhere
    </h2>

    <div class="max-w-sm">
      <!-- Photography: styled in PHOTO//SCOPE's own terminal aesthetic -->
      <a
        href="/photoscope/"
        data-astro-reload
        class="scope-card outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-dashed"
        aria-label="PHOTO//SCOPE, film photography"
      >
        <p class="scope-card-label">Photography //</p>
        <p class="scope-card-title">
          <img
            src="/logo.svg"
            alt=""
            class="scope-card-mark"
            width="10"
            height="18"
          />
          <span>PHOTO//SCOPE</span>
        </p>
        <p class="scope-card-sub">
          Film photos plotted where they were shot. Mostly 35mm.
        </p>
      </a>
    </div>

    <p class="mt-5 text-sm text-foreground/70">
      Or <a
        href="/contact"
        class="underline decoration-dashed underline-offset-4 hover:text-accent"
        >get in touch</a
      > about roles, projects or solar cars.
    </p>
  </section>
</Layout>

<script>
  /* ── Build photos strip ─────────────────────────────────────────── */
  /*
   * Shuffles the photos on each visit, then drifts them sideways in an
   * endless loop (the set is cloned once so the wrap is seamless).
   * Pauses on hover, touch, keyboard focus and after an arrow click, and
   * when the strip is off screen. Static under prefers-reduced-motion.
   * Manual scrolling still works; the drift picks up from wherever the
   * visitor left it.
   */
  const STRIP_SPEED = 28; // px per second

  function initStrip() {
    const ul = document.getElementById("workshop-strip");
    if (!ul || ul.dataset.shuffled) return;
    ul.dataset.shuffled = "1";
    const items = Array.from(ul.children) as HTMLElement[];
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    items.forEach(li => ul.appendChild(li));

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let hovered = false;
    let focused = false;
    let visible = false;
    let holdUntil = 0;
    const hold = (ms: number) => {
      holdUntil = performance.now() + ms;
    };

    document
      .querySelectorAll<HTMLButtonElement>("[data-strip-dir]")
      .forEach(btn => {
        btn.addEventListener("click", () => {
          hold(3000);
          const dir = Number(btn.dataset.stripDir || 1);
          ul.scrollBy({ left: dir * ul.clientWidth * 0.8, behavior: "smooth" });
        });
      });

    if (reduced || items.length < 2) return;

    // Clone the set once so scrolling past the end wraps back invisibly
    items.forEach(li => {
      const clone = li.cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      clone.querySelectorAll("a").forEach(a => a.setAttribute("tabindex", "-1"));
      ul.appendChild(clone);
    });
    const loopWidth = () =>
      (ul.children[items.length] as HTMLElement).offsetLeft -
      items[0].offsetLeft;

    ul.addEventListener("pointerenter", e => {
      if (e.pointerType === "mouse") hovered = true;
    });
    ul.addEventListener("pointerleave", () => (hovered = false));
    ul.addEventListener("touchstart", () => hold(4000), { passive: true });
    ul.addEventListener("wheel", () => hold(2000), { passive: true });
    ul.addEventListener("focusin", () => (focused = true));
    ul.addEventListener("focusout", () => (focused = false));

    new IntersectionObserver(entries => {
      visible = entries.some(e => e.isIntersecting);
    }).observe(ul);

    // Keep a float position: scrollLeft rounds on some displays, which
    // would stall a sub-pixel per-frame step.
    let pos = ul.scrollLeft;
    let last = performance.now();
    function tick(now: number) {
      if (!ul!.isConnected) return;
      const dt = Math.min(now - last, 100) / 1000;
      last = now;
      // The visitor scrolled it themselves: follow their position
      if (Math.abs(ul!.scrollLeft - pos) > 2) pos = ul!.scrollLeft;
      if (visible && !hovered && !focused && now > holdUntil) {
        pos += STRIP_SPEED * dt;
        const w = loopWidth();
        if (w > 0 && pos >= w) pos -= w;
        ul!.scrollLeft = pos;
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  initStrip();
  document.addEventListener("astro:after-swap", initStrip);

  /* ── Blueprint-grid hero accent ─────────────────────────────────── */
  /*
   * Renders a fine dotted grid on a canvas behind the hero text.
   * Gently shifts offset with pointer on desktop; completely static on
   * touch devices. Hidden under prefers-reduced-motion.
   * No continuous rAF while idle: redraws only on pointermove,
   * theme change, and resize (debounced).
   */
  function initHeroGrid() {
    const section = document.getElementById("hero") as HTMLElement | null;
    const wrapper = document.getElementById("hero-grid") as HTMLElement | null;
    const canvas = document.getElementById(
      "hero-canvas"
    ) as HTMLCanvasElement | null;
    if (!section || !wrapper || !canvas) return;

    // Respect reduced-motion: leave hidden, don't wire up anything.
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mq.matches) return;

    // Don't wire pointer effects on touch-primary devices.
    const isTouch = window.matchMedia(
      "(hover: none) and (pointer: coarse)"
    ).matches;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let offsetX = 0;
    let offsetY = 0;
    let rafId: number | null = null;

    function getAccentColor(): string {
      return getComputedStyle(document.documentElement)
        .getPropertyValue("--accent")
        .trim();
    }

    function drawGrid(ox: number, oy: number) {
      const W = canvas!.width;
      const H = canvas!.height;
      ctx!.clearRect(0, 0, W, H);

      const color = getAccentColor() || "#006cac";
      ctx!.strokeStyle = color;
      ctx!.globalAlpha = 0.07;
      ctx!.lineWidth = 0.5;

      const step = 28;
      const startX = ((ox % step) + step) % step;
      const startY = ((oy % step) + step) % step;

      ctx!.beginPath();
      for (let x = startX - step; x < W + step; x += step) {
        ctx!.moveTo(x, 0);
        ctx!.lineTo(x, H);
      }
      for (let y = startY - step; y < H + step; y += step) {
        ctx!.moveTo(0, y);
        ctx!.lineTo(W, y);
      }
      ctx!.stroke();

      // Dot intersections
      ctx!.globalAlpha = 0.12;
      for (let x = startX - step; x < W + step; x += step) {
        for (let y = startY - step; y < H + step; y += step) {
          ctx!.beginPath();
          ctx!.arc(x, y, 1.1, 0, Math.PI * 2);
          ctx!.fillStyle = color;
          ctx!.fill();
        }
      }
      ctx!.globalAlpha = 1;
    }

    function resize() {
      const rect = section!.getBoundingClientRect();
      canvas!.width = rect.width;
      canvas!.height = rect.height;
      drawGrid(offsetX, offsetY);
    }

    // Fade in
    wrapper.style.opacity = "1";

    resize();

    // Debounced resize
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    });

    // Pointer move: desktop only, no continuous loop
    if (!isTouch) {
      section.addEventListener("pointermove", (e: PointerEvent) => {
        if (e.pointerType === "touch") return;
        const rect = section.getBoundingClientRect();
        const cx = (e.clientX - rect.left) / rect.width - 0.5;
        const cy = (e.clientY - rect.top) / rect.height - 0.5;
        offsetX = cx * 18;
        offsetY = cy * 18;
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          drawGrid(offsetX, offsetY);
          rafId = null;
        });
      });

      section.addEventListener("pointerleave", () => {
        offsetX = 0;
        offsetY = 0;
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          drawGrid(0, 0);
          rafId = null;
        });
      });
    }

    // Redraw when theme changes (MutationObserver on html[data-theme])
    const themeObserver = new MutationObserver(() => {
      drawGrid(offsetX, offsetY);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  initHeroGrid();
  document.addEventListener("astro:after-swap", initHeroGrid);
</script>

<style>
  .strip-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    background: transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .strip-btn:hover,
  .strip-btn:focus-visible {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
  }

  /* PHOTO//SCOPE card: carries the terminal aesthetic of the page it
     links to, deliberately breaking the site palette in both themes. */
  .scope-card {
    display: block;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(57, 255, 136, 0.28);
    background: rgba(5, 11, 8, 0.92);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, "Cascadia Code", monospace;
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .scope-card:hover,
  .scope-card:focus-visible {
    border-color: rgba(57, 255, 136, 0.7);
    box-shadow:
      0 0 18px rgba(57, 255, 136, 0.22),
      inset 0 0 14px rgba(57, 255, 136, 0.05);
  }
  .scope-card-label {
    margin-bottom: 0.5rem;
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(77, 255, 155, 0.55);
  }
  .scope-card-title {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #4dff9b;
    text-shadow: 0 0 6px rgba(57, 255, 136, 0.4);
  }
  .scope-card-sub {
    margin-top: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: rgba(77, 255, 155, 0.5);
  }
  .scope-card-mark {
    display: block;
    height: 15px;
    width: auto;
    filter: drop-shadow(0 0 4px rgba(57, 255, 136, 0.35));
  }
</style>
