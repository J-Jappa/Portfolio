---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { thumbSrc } from "@/utils/thumbs";
import CurrawongExplode from "@/components/CurrawongExplode.astro";

/** Extract the year from an ISO date string, or return null */
function yearOf(date?: string): string | null {
  if (!date) return null;
  const m = date.match(/^(\d{4})/);
  return m ? m[1] : null;
}

export async function getStaticPaths() {
  const projects = (await getCollection(
    "projects",
    // Drafts still render in `astro dev` so they can be previewed
    ({ data }) => import.meta.env.DEV || !data.draft
  )) as CollectionEntry<"projects">[];
  return projects.map(p => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await project.render();
const p = project.data;

const year = yearOf(p.date);
---

<Layout title={p.title} description={p.summary} ogImage={p.hero ?? undefined}>
  <article class="max-w-none">
    {/* ── Back link ──────────────────────────────────────────────── */}
    <a
      href="/"
      class="group inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm transition-all hover:border-accent/60 hover:text-accent"
    >
      <span
        aria-hidden="true"
        class="transition-transform group-hover:-translate-x-0.5">←</span
      >
      <span class="u-ink">All projects</span>
    </a>

    {/* ── Title + summary ──────────────────────────────────────── */}
    <header class="mt-5 mb-6">
      <h1
        class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"
        style="font-family: var(--font-site);"
      >
        {p.title}
      </h1>
      <p class="mt-2 max-w-[65ch] text-base leading-relaxed opacity-80">
        {p.summary}
      </p>
      {/* One plain line of context in place of a boxed spec sheet */}
      <p class="mt-3 max-w-[65ch] text-sm text-foreground/60">
        {[p.role, year].filter(Boolean).join(", ")}.
        {
          p.tags?.includes("Solar Racing") && (
            <>
              {" "}Part of Monty, ANU Solar Racing's 2025 car (<a href="/solar-racing/" class="underline decoration-dashed underline-offset-4 hover:text-accent">what is solar racing?</a>).
            </>
          )
        }
        {
          p.repo && (
            <>
              {" "}
              <a
                href={p.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
              >Code on GitHub</a>.
            </>
          )
        }
        {
          p.link && (
            <>
              {" "}
              <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-dashed underline-offset-4 hover:text-accent"
              >See it live</a>.
            </>
          )
        }
      </p>
    </header>

    {/* ── Interactive 3D hero (frontmatter hero3d) ── */}
    {p.hero3d === "currawong" && <CurrawongExplode />}

    {/* ── Image strip (opens the shared site lightbox) ──────────── */}
    {
      /*
        Thumbnails keep the thumbSrc md5 → /thumbs/*.webp mechanism.
        Full images open in Layout.astro's #site-lightbox via data-lb-src.
    */
    }
    {
      p.images?.length > 0 && !p.hero3d && (
        <div class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {p.images.map((img: { src: string; alt?: string }, i: number) => (
            <div class="group relative overflow-hidden rounded-xl border border-border hover:border-accent/50">
              <button
                class="m-0 block aspect-video w-full overflow-hidden border-0 bg-transparent p-0"
                data-lb-src={img.src}
                data-lb-alt={img.alt ?? p.title}
                data-lb-caption={img.alt ?? ""}
                aria-label={`Open image ${i + 1}: ${img.alt ?? p.title}`}
              >
                <img
                  src={thumbSrc(img.src)}
                  alt={img.alt ?? p.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </div>
          ))}
        </div>
      )
    }

    {/* ── Prose body ───────────────────────────────────────────── */}
    {
      /*
        Running text is centred in a fixed 42rem (max-w-2xl) column.
        The measure must be an absolute unit shared by every element:
        ch scales with each element's own font size, so headings sized
        in ch get a wider box than paragraphs and their left edges
        stop lining up. Figures / ImageRows inside MDX break out to
        full column width via .not-prose (already on Figure/ImageRow).
    */
    }
    <section class="project-prose mt-2">
      <div
        class="prose max-w-none dark:prose-invert prose-headings:mx-auto prose-headings:max-w-2xl prose-headings:font-semibold prose-headings:tracking-tight prose-p:mx-auto prose-p:max-w-2xl prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:mx-auto prose-blockquote:max-w-2xl prose-ol:mx-auto prose-ol:max-w-2xl prose-ul:mx-auto prose-ul:max-w-2xl prose-hr:mx-auto prose-hr:max-w-2xl prose-li:text-foreground"
      >
        <Content />
      </div>
    </section>

    {/* ── Outcomes block ─────────────────────────────────────────── */}
    {
      p.outcomes?.length > 0 && (
        <section class="mx-auto mt-10 max-w-2xl" aria-label="What came of it">
          <h2
            class="mb-3 text-xl font-semibold tracking-tight"
            style="font-family: var(--font-site);"
          >
            What came of it
          </h2>
          <ul class="ml-5 list-disc space-y-2 text-base leading-relaxed marker:text-accent">
            {p.outcomes.map((o: string) => <li>{o}</li>)}
          </ul>
        </section>
      )
    }
  </article>
</Layout>
