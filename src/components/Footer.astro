---
import { SITE } from "@/config";
const year = new Date().getFullYear();
---

<footer class="mt-12 w-full border-t border-border">
  <div class="mx-auto max-w-app px-4 py-8">
    <!-- Top row: identity + nav -->
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"
    >
      <!-- Identity -->
      <span
        class="text-base font-semibold tracking-tight"
        style="font-family: var(--font-site);"
      >
        Jasper Japp
      </span>

      <!-- Footer nav -->
      <nav
        class="flex flex-wrap gap-x-5 gap-y-2"
        aria-label="Footer navigation"
      >
        <a
          href="/"
          class="-my-2 inline-block py-2 text-sm text-foreground/60 no-underline transition-colors hover:text-accent"
        >
          Projects
        </a>
        <a
          href="/about"
          class="-my-2 inline-block py-2 text-sm text-foreground/60 no-underline transition-colors hover:text-accent"
        >
          About
        </a>
        <a
          href="/experience"
          class="-my-2 inline-block py-2 text-sm text-foreground/60 no-underline transition-colors hover:text-accent"
        >
          Experience
        </a>
        <a
          href="/contact"
          class="-my-2 inline-block py-2 text-sm text-foreground/60 no-underline transition-colors hover:text-accent"
        >
          Contact
        </a>
        {
          SITE.linkedinUrl && (
            <a
              href={SITE.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="-my-2 inline-block py-2 text-sm text-foreground/60 no-underline transition-colors hover:text-accent"
            >
              LinkedIn ↗
            </a>
          )
        }
      </nav>
    </div>

    <!-- Bottom row: copyright -->
    <div class="mt-6 border-t border-border/50 pt-5">
      <p class="t-label opacity-40">© {year} Jasper Japp</p>
    </div>
  </div>
</footer>
