---
// One-slot comparison carousel: shows a set of same-subject images in the
// footprint of a single figure, auto-advancing slowly, with arrows, keyboard
// and a row of thumbnails to jump straight to one. Built for flipping
// between design variants.
//
// The frame takes its shape from the images themselves (the median aspect
// ratio of the set, read at build time), so a set of wide strips gets a
// wide, short frame and photos get a photo-shaped one. Pass `ratio` to
// override it.
import sharp from "sharp";
import path from "node:path";

type Img = { src: string; alt?: string; caption?: string };
interface Props {
  images: Img[];
  /** Frame aspect ratio (width / height). Defaults to the images' median */
  ratio?: number;
  /** Extra classes for the frame */
  class?: string;
  /** Background behind each image (default: the light panel for screenshots) */
  panel?: string;
}
const { images = [], ratio: ratioProp, class: className, panel } = Astro.props;

async function aspect(src: string): Promise<number | null> {
  if (!src.startsWith("/")) return null;
  try {
    const m = await sharp(path.join(process.cwd(), "public", decodeURI(src))).metadata();
    return m.width && m.height ? m.width / m.height : null;
  } catch {
    return null;
  }
}
const ratios = (await Promise.all(images.map(i => aspect(i.src)))).filter((r): r is number => r !== null).sort((a, b) => a - b);
const median = ratios.length ? ratios[Math.floor((ratios.length - 1) / 2)] : 16 / 9;
const ratio = ratioProp ?? median;
---

<div class="cmp not-prose zine-figure my-5" data-cmp style={panel ? `--cmp-panel: ${panel}` : undefined}>
  <div class:list={["cmp-frame relative overflow-hidden rounded-xl border border-border", className]} style={`aspect-ratio: ${ratio.toFixed(4)}`}>
    <div class="cmp-track flex h-full" data-track>
      {
        images.map((img, i) => (
          <div class="cmp-cell h-full w-full flex-none" data-caption={img.caption ?? ""}>
            <img
              src={img.src}
              alt={img.alt ?? `Variant ${i + 1}`}
              class="h-full w-full object-contain"
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable={false}
            />
          </div>
        ))
      }
    </div>
    <button type="button" class="cmp-arrow cmp-prev" data-prev aria-label="Previous image">‹</button>
    <button type="button" class="cmp-arrow cmp-next" data-next aria-label="Next image">›</button>
  </div>
  <div class="cmp-thumbs" role="group" aria-label="Choose an image">
    {
      images.map((img, i) => (
        <button
          type="button"
          class="cmp-thumb"
          data-go={i}
          aria-label={`Show image ${i + 1} of ${images.length}${img.caption ? `: ${img.caption}` : ""}`}
          aria-current={i === 0 ? "true" : "false"}
        >
          <img src={img.src} alt="" loading="lazy" decoding="async" draggable={false} />
        </button>
      ))
    }
  </div>
  <figcaption class="cmp-cap mt-1 text-left" data-cap aria-live="polite"></figcaption>
</div>

<script>
  function initCompares() {
    document.querySelectorAll<HTMLElement>("[data-cmp]").forEach(root => {
      // Versioned, so a carousel set up by an older copy of this script
      // (left over from a hot reload) still gets the thumbnails wired up
      if (root.dataset.cmpMounted === "2") return;
      root.dataset.cmpMounted = "2";
      const track = root.querySelector<HTMLElement>("[data-track]");
      const cells = Array.from(root.querySelectorAll<HTMLElement>(".cmp-cell"));
      const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-go]"));
      const cap = root.querySelector<HTMLElement>("[data-cap]");
      if (!track || cells.length === 0) return;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const n = cells.length;
      let i = 0;
      let timer = 0;

      function show(k: number) {
        i = ((k % n) + n) % n;
        track!.style.transform = `translateX(${-i * 100}%)`;
        thumbs.forEach((t, j) => t.setAttribute("aria-current", String(j === i)));
        if (cap) cap.textContent = cells[i].dataset.caption || "";
      }
      function restart() {
        window.clearInterval(timer);
        if (!reduced) timer = window.setInterval(() => show(i + 1), 3200);
      }
      root.querySelector("[data-prev]")?.addEventListener("click", () => {
        show(i - 1);
        restart();
      });
      root.querySelector("[data-next]")?.addEventListener("click", () => {
        show(i + 1);
        restart();
      });
      thumbs.forEach(t =>
        t.addEventListener("click", () => {
          show(Number(t.dataset.go));
          restart();
        })
      );
      root.addEventListener("mouseenter", () => window.clearInterval(timer));
      root.addEventListener("mouseleave", restart);
      root.addEventListener("keydown", e => {
        if (e.key === "ArrowLeft") { e.preventDefault(); show(i - 1); restart(); }
        else if (e.key === "ArrowRight") { e.preventDefault(); show(i + 1); restart(); }
      });
      // Only advance while on screen
      const io = new IntersectionObserver(entries => {
        if (entries.some(e => e.isIntersecting)) restart();
        else window.clearInterval(timer);
      });
      io.observe(root);
      show(0);
    });
  }
  initCompares();
  document.addEventListener("astro:after-swap", initCompares);
</script>

<style>
  /* Tall photos inside a wide frame (or the reverse) never take over the
     screen */
  .cmp-frame {
    max-height: 75svh;
  }
  /* The source screenshots have their own light background; a fixed light
     panel keeps them seamless in both themes. */
  .cmp-cell,
  .cmp-thumb {
    background: var(--cmp-panel, #eef1f4);
  }
  .cmp-track {
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .cmp-track {
      transition: none;
    }
  }
  .cmp-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 85%, transparent);
    color: var(--color-foreground);
    font-size: 1.25rem;
    line-height: 1;
    padding-bottom: 0.15rem;
    cursor: pointer;
    backdrop-filter: blur(2px);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .cmp-arrow:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  .cmp-prev {
    left: 0.6rem;
  }
  .cmp-next {
    right: 0.6rem;
  }
  .cmp-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .cmp-thumb {
    width: 4.25rem;
    height: 2.75rem;
    padding: 0;
    overflow: hidden;
    border-radius: 0.4rem;
    border: 1px solid var(--color-border);
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity 0.15s ease,
      border-color 0.15s ease;
  }
  .cmp-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cmp-thumb:hover,
  .cmp-thumb:focus-visible {
    opacity: 0.9;
  }
  .cmp-thumb[aria-current="true"] {
    opacity: 1;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .cmp-cap {
    min-height: 1.4em;
    font-size: 0.8rem;
    line-height: 1.5;
    font-style: italic;
    color: color-mix(in srgb, currentColor 65%, transparent);
  }
</style>
