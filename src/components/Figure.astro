---
/** Props (fully backward compatible — no changes to public interface):
 *  - src: string
 *  - alt?: string
 *  - width?: string = "100%"
 *  - maxWidth?: string = "none"
 *  - caption?: string
 *  - lightbox?: boolean = true
 */
interface Props {
  src: string;
  alt?: string;
  width?: string;
  maxWidth?: string;
  caption?: string;
  lightbox?: boolean;
}

const {
  src,
  alt = "",
  width = "100%",
  maxWidth = "none",
  caption,
  lightbox = true,
} = Astro.props as Props;

const styleObj = { width, maxWidth, marginInline: "auto" };
---

<figure class="not-prose my-5 zine-figure" style={styleObj}>
  {lightbox ? (
    <>
      {/* Opens the shared #site-lightbox in Layout.astro */}
      <button
        type="button"
        class="block w-full overflow-hidden rounded-xl border border-border p-0 m-0 bg-transparent
               transition-colors hover:border-accent/50
               focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-accent"
        data-lb-src={src}
        data-lb-alt={alt}
        data-lb-caption={caption ?? ""}
        aria-label={alt ? `Open image: ${alt}` : "Open image"}
      >
        <img
          src={src}
          alt={alt}
          loading="lazy"
          decoding="async"
          class="w-full rounded-xl object-cover"
        />
      </button>

      {caption && (
        <figcaption class="zine-caption mt-2 text-left">
          {caption}
        </figcaption>
      )}
    </>
  ) : (
    <>
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="w-full rounded-xl border border-border object-cover"
      />
      {caption && (
        <figcaption class="zine-caption mt-2 text-left">
          {caption}
        </figcaption>
      )}
    </>
  )}
</figure>

<style>
  /* Plain italic caption. No figure numbers: nothing in the prose refers
     to a figure by number, so a counter would only be decoration. */
  .zine-caption {
    font-size: 0.8rem;
    line-height: 1.5;
    color: color-mix(in srgb, currentColor 65%, transparent);
    font-style: italic;
  }
</style>
